---
import Base from "../layouts/Base.astro";
import news from "../data/news.json";

// Accept public/photo.<any common image extension> so replacing the photo
// never silently breaks the page; without one, the fallback avatar shows.
// Build-time glob, not node:fs: Cloudflare prerenders inside workerd, where
// Node modules don't exist. Changing the photo file needs a dev restart.
const photoMatches = import.meta.glob("/public/photo.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}");
const photoKey = Object.keys(photoMatches)[0];
const photoSrc = photoKey ? photoKey.replace("/public", "") : "/portrait-fallback.svg";

const fmt = (d: string) =>
  new Intl.DateTimeFormat("en", { month: "short", year: "numeric", timeZone: "UTC" }).format(
    new Date(d + "-01T00:00:00Z"),
  );
---

<Base>
  <section class="hero">
    <aside class="portrait-side">
      <div class="portrait-frame" id="portrait-frame">
        <div class="portrait-3d">
          <img
            class="portrait"
            src={photoSrc}
            alt="Pradeep Pandey"
            width="1024"
            height="1024"
            onerror="this.onerror=null;this.src='/portrait-fallback.svg'"
          />
          <span class="portrait-glass" aria-hidden="true"></span>
        </div>
      </div>
      <div class="portrait-caption">
        <div class="id-name">Pradeep Pandey</div>
        <div>BCA @ Butwal Kalika Campus</div>
        <div>Butwal, Nepal</div>
        <div class="id-email">pradeepandey.r [at] gmail [dot] com</div>
      </div>
    </aside>
    <div class="hero-text">
      <p class="lede">
        I intend to spend my career on <a
          class="lede-hl"
          href="https://en.wikipedia.org/wiki/AI_safety"
          target="_blank"
          rel="noopener"
          title="AI safety on Wikipedia (covers alignment)">AI safety &amp; alignment</a
        > research.
      </p>
      <p>
        The questions that hold my attention: how stable are the safety behaviors of language models (refusal above
        all) when you push on them; what internal, activation-level structure produces those behaviors, and how much
        of that can be evaluated rigorously on open-weight models and small budgets.
      </p>
      <p>
        Right now I'm laying the foundations for that work (mathematics, Python, classical machine learning, and
        transformer internals) as a BCA student at Butwal Kalika Campus (Tribhuvan University), Butwal, Nepal. I work in public: articles,
        replications, projects, and eventually papers will appear here as they become real.
      </p>
    </div>
  </section>

  <h2 class="section-head">Interests</h2>
  <ul class="chips" aria-label="Research interests">
    {
      ["AI safety", "Alignment", "Interpretability", "Robustness evaluation", "Multilingual safety"].map((k) => (
        <li class="chip">{k}</li>
      ))
    }
  </ul>

  <h2 class="section-head">News</h2>
  <ul class="news">
    {
      news.map((n) => (
        <li>
          <span class="news-date">{fmt(n.date)}</span>
          <span>{n.text}</span>
        </li>
      ))
    }
  </ul>
</Base>
