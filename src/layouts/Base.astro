---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Socials from "../components/Socials.astro";
import fs from "node:fs";
import { join } from "node:path";

declare const __SITE_ROOT__: string; // injected in astro.config.mjs

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Pradeep Pandey",
  description = "Pradeep Pandey. Building toward AI safety and alignment research. Articles, papers, and projects as they become real.",
} = Astro.props;

// The CV link appears by itself once public/cv.pdf exists, so the nav can never
// point at a missing file. Checked with fs against __SITE_ROOT__ (not cwd, not
// import.meta.url: the first differs under `npm --prefix`, the second moves into
// the bundle at build). Runs per request in dev, so dropping the file in just
// needs a page refresh, and at page-generation time in builds.
const hasCV = fs.existsSync(join(__SITE_ROOT__, "public", "cv.pdf"));

const nav = [
  { href: "/", label: "Main" },
  { href: "/papers/", label: "Papers" },
  { href: "/articles/", label: "Articles" },
  { href: "/projects/", label: "Projects" },
  ...(hasCV ? [{ href: "/cv.pdf", label: "CV", file: true }] : []),
];
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href.replace(/\/$/, ""));
---

<!-- transition:animate="none": keep ClientRouter's SPA swap but skip the animated
     snapshots, which can freeze mid-flight (ghost page, phantom scrollbar). -->
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {/* Search engines welcome; AI training crawlers are opted out here and in robots.txt. */}
    <meta name="robots" content="index, follow, noai, noimageai" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Pradeep Pandey: Articles" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Set theme before first paint: saved choice wins, else system preference.
      // Re-applied after every ClientRouter swap; toggle wired via delegation so
      // both survive SPA navigations.
      (() => {
        const apply = () => {
          let t;
          try {
            t = localStorage.getItem("theme");
          } catch {}
          if (t !== "light" && t !== "dark")
            t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.dataset.theme = t;
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
        document.addEventListener("click", (e) => {
          if (!(e.target instanceof Element) || !e.target.closest("#theme-toggle")) return;
          const r = document.documentElement;
          const t = r.dataset.theme === "dark" ? "light" : "dark";
          r.dataset.theme = t;
          try {
            localStorage.setItem("theme", t);
          } catch {}
        });
      })();
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap masthead">
        <a class="masthead-name" href="/">Pradeep Pandey</a>
        <div class="masthead-tag">Building toward AI safety &amp; alignment research</div>
      </div>
      <nav class="site-nav" aria-label="Site">
        {
          nav.map((n) => (
            <a
              href={n.href}
              aria-current={isCurrent(n.href) ? "page" : undefined}
              target={n.file ? "_blank" : undefined}
              rel={n.file ? "noopener" : undefined}
            >
              {n.label}
            </a>
          ))
        }
      </nav>
      <div class="header-controls">
        <button class="icon-btn" id="theme-toggle" aria-label="Toggle dark / light theme" title="Toggle theme">
          <svg
            class="icon-moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path></svg
          >
          <svg
            class="icon-sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="4"></circle><path
              d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path></svg
          >
        </button>
      </div>
    </header>

    <Socials variant="rail" showCV={hasCV} />

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <Socials variant="row" showCV={hasCV} />
        <span>© 2026 Pradeep Pandey · <a href="/rss.xml">RSS</a></span>
      </div>
    </footer>
  </body>
</html>
