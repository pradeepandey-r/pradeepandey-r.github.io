---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Socials from "../components/Socials.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Pradeep Pandey",
  description = "Pradeep Pandey. Building toward AI safety and alignment research. Articles, papers, and projects as they become real.",
} = Astro.props;

// The CV icon (in the social rail) appears by itself once public/cv.pdf exists,
// so it can never point at a missing file. Detected with Vite's BUILD-TIME glob,
// not node:fs: Cloudflare prerenders inside workerd, where Node modules don't
// exist (their build died on `node:fs`). Trade-off: after adding/removing the
// file, restart `npm run dev`; real builds always see the current state.
const hasCV = Object.keys(import.meta.glob("/public/cv.pdf")).length > 0;

const nav = [
  { href: "/", label: "Main" },
  { href: "/papers/", label: "Papers" },
  { href: "/articles/", label: "Articles" },
  { href: "/projects/", label: "Projects" },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href.replace(/\/$/, ""));
---

<!-- transition:animate="none": keep ClientRouter's SPA swap but skip the animated
     snapshots, which can freeze mid-flight (ghost page, phantom scrollbar). -->
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {/* Search engines welcome; AI training crawlers are opted out here and in robots.txt. */}
    <meta name="robots" content="index, follow, noai, noimageai" />
    {/* ?v= busts browser/CDN favicon caches when the icon changes */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="alternate" type="application/rss+xml" title="Pradeep Pandey: Articles" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Set theme before first paint: saved choice wins, else system preference.
      // Re-applied after every ClientRouter swap; toggle wired via delegation so
      // both survive SPA navigations.
      (() => {
        const apply = () => {
          let t;
          try {
            t = localStorage.getItem("theme");
          } catch {}
          if (t !== "light" && t !== "dark")
            t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.dataset.theme = t;
        };
        const syncSwitch = () => {
          const b = document.getElementById("theme-toggle");
          if (b) b.setAttribute("aria-checked", String(document.documentElement.dataset.theme === "dark"));
        };
        // 3D tilt on the portrait: pointer position drives rotation, the glass
        // glare (--gx/--gy) and the red glow offset (--glow-x/--glow-y) follow.
        // Pointer events with a per-event mouse check (NOT a matchMedia hover
        // guard: touchscreen laptops can report hover:none and lose the effect
        // entirely). Bound on several hooks because ClientRouter swaps the
        // element; the dataset flag prevents double-binding.
        const bindTilt = () => {
          const f = document.getElementById("portrait-frame");
          if (!f || f.dataset.tiltBound) return;
          f.dataset.tiltBound = "1";
          const MAX = 9;
          f.addEventListener("pointermove", (e) => {
            if (e.pointerType && e.pointerType !== "mouse") return;
            const r = f.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width - 0.5;
            const py = (e.clientY - r.top) / r.height - 0.5;
            f.style.setProperty("--ry", (px * 2 * MAX).toFixed(2) + "deg");
            f.style.setProperty("--rx", (-py * 2 * MAX).toFixed(2) + "deg");
            // the glare sits exactly under the pointer (1:1), like real glass
            f.style.setProperty("--gx", ((px + 0.5) * 100).toFixed(1) + "%");
            f.style.setProperty("--gy", ((py + 0.5) * 100).toFixed(1) + "%");
            f.style.setProperty("--glare-o", "0.22");
            f.style.setProperty("--glow-x", (px * -16).toFixed(1) + "px");
            f.style.setProperty("--glow-y", (py * -12).toFixed(1) + "px");
          });
          f.addEventListener("pointerleave", () => {
            for (const p of ["--rx", "--ry", "--gx", "--gy", "--glare-o", "--glow-x", "--glow-y"])
              f.style.removeProperty(p);
          });
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
        document.addEventListener("astro:page-load", syncSwitch);
        document.addEventListener("astro:page-load", bindTilt);
        document.addEventListener("DOMContentLoaded", bindTilt);
        if (document.readyState !== "loading") bindTilt();
        document.addEventListener("click", (e) => {
          if (!(e.target instanceof Element) || !e.target.closest("#theme-toggle")) return;
          const r = document.documentElement;
          const t = r.dataset.theme === "dark" ? "light" : "dark";
          r.dataset.theme = t;
          try {
            localStorage.setItem("theme", t);
          } catch {}
          syncSwitch();
        });
      })();
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap masthead">
        <a class="masthead-name" href="/">Pradeep Pandey</a>
        <div class="masthead-tag">Building toward AI safety &amp; alignment research</div>
      </div>
      <div class="wrap nav-wrap">
        <nav class="site-nav" aria-label="Site">
          {nav.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>{n.label}</a>)}
        </nav>
        <button class="theme-switch" id="theme-toggle" role="switch" aria-checked="false" aria-label="Dark theme">
          <svg
            class="sw-sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="4.5"></circle><path
              d="M12 2v2.5m0 15V22M4.9 4.9l1.8 1.8m10.6 10.6 1.8 1.8M2 12h2.5m15 0H22M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
            ></path></svg
          >
          <svg class="sw-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path></svg
          >
          <span class="knob" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <Socials variant="rail" showCV={hasCV} />

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <Socials variant="row" showCV={hasCV} />
        <span>© 2026 Pradeep Pandey · <a href="/rss.xml">RSS</a></span>
      </div>
    </footer>
  </body>
</html>
